{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamviva",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/config.js", "/proxy", "/m3u8-proxy"]
  },
  "observability": {
    "enabled": true
  }
}
